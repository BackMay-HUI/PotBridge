{
  "manifest_version": 3,
  "name": "PotBridge · 映桥",
  "version": "0.1.0",
  "description": "在 Edge 中识别当前视频，通过本机中转交给 PotPlayer 播放。",
  "minimum_chrome_version": "120",
  "permissions": ["webRequest", "nativeMessaging", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "PotBridge · 用 PotPlayer 播放", "default_popup": "popup.html" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
